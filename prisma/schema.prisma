generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Usuario {
  id          Int      @id @default(autoincrement())
  nome        String   @db.VarChar(100)
  username    String   @unique @db.VarChar(50)
  email       String   @unique @db.VarChar(100)
  senha       String   @db.VarChar(255)
  bio         String?  @db.Text
  cidade      String?  @db.VarChar(100)
  contato     String?  @db.VarChar(100)
  fotoPerfil       String?   @map("foto_perfil") @db.Text
  fotoCapa         String?   @map("foto_capa") @db.Text
  perfilConfig     String?   @map("perfil_config") @db.Text
  configuracoes    String?   @map("configuracoes") @db.Text
  criadoEm         DateTime  @default(now()) @map("criado_em")
  resetToken       String?   @map("reset_token") @db.VarChar(255)
  resetTokenExpiry DateTime? @map("reset_token_expiry")
  emailVerificado  Boolean   @default(true) @map("email_verificado")
  emailVerifToken  String?   @map("email_verif_token") @db.VarChar(255)
  emailVerifExpiry DateTime? @map("email_verif_expiry")

  posts                  Post[]
  postsColaboracoes      PostColaboracao[]
  catalogos              Catalogo[]
  catalogosColaboracoes  CatalogoColaboracao[]
  curtidas               Curtida[]
  comentarios            Comentario[]
  mensagensEnviadas      Mensagem[] @relation("Remetente")
  mensagensRecebidas     Mensagem[] @relation("Destinatario")
  conversaConfigs        ConversaConfig[]
  mensagensDeletadas     MensagemDeletada[]
  seguidores             Seguidor[] @relation("Seguido")
  seguindo               Seguidor[] @relation("Seguidor")
  notificacoesRecebidas  Notificacao[] @relation("NotifDestinatario")
  notificacoesEnviadas   Notificacao[] @relation("NotifRemetente")
  postsSalvos            PostSalvo[]
  catalogosSalvos        CatalogoSalvo[]

  @@map("usuarios")
}

model Post {
  id            Int      @id @default(autoincrement())
  usuarioId     Int      @map("usuario_id")
  titulo        String   @db.VarChar(150)
  descricao     String?  @db.Text
  imagem        String?  @db.Text
  imagens       String[] @default([])
  tags          String[] @default([])
  visualizacoes Int      @default(0)
  dataPostagem  DateTime @default(now()) @map("data_postagem")

  autor         Usuario             @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  colaboracoes  PostColaboracao[]
  catalogos     CatalogoPost[]
  curtidas      Curtida[]
  comentarios   Comentario[]
  notificacoes  Notificacao[]
  salvos        PostSalvo[]

  @@map("posts")
}

enum StatusColaboracao {
  pendente
  aceito
  recusado
}

model PostColaboracao {
  postId    Int                @map("post_id")
  usuarioId Int                @map("usuario_id")
  status    StatusColaboracao  @default(pendente)

  post    Post    @relation(fields: [postId], references: [id], onDelete: Cascade)
  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@id([postId, usuarioId])
  @@map("posts_colaboracoes")
}

model Catalogo {
  id          Int      @id @default(autoincrement())
  usuarioId   Int      @map("usuario_id")
  nome        String   @db.VarChar(150)
  descricao   String?  @db.Text
  capa        String?  @db.Text
  dataCriacao DateTime @default(now()) @map("data_criacao")

  dono          Usuario               @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  colaboracoes  CatalogoColaboracao[]
  posts         CatalogoPost[]
  imagens       CatalogoImagem[]
  notificacoes  Notificacao[]
  salvos        CatalogoSalvo[]

  @@map("catalogos")
}

model CatalogoImagem {
  id          Int      @id @default(autoincrement())
  catalogoId  Int      @map("catalogo_id")
  imagem      String   @db.Text
  dataCriacao DateTime @default(now()) @map("data_criacao")

  catalogo Catalogo @relation(fields: [catalogoId], references: [id], onDelete: Cascade)

  @@map("catalogo_imagens")
}

model CatalogoColaboracao {
  catalogoId Int                @map("catalog_id")
  usuarioId  Int                @map("usuario_id")
  status     StatusColaboracao  @default(pendente)

  catalogo Catalogo @relation(fields: [catalogoId], references: [id], onDelete: Cascade)
  usuario  Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@id([catalogoId, usuarioId])
  @@map("catalogos_colaboracoes")
}

model CatalogoPost {
  catalogoId Int @map("catalog_id")
  postId     Int @map("post_id")

  catalogo Catalogo @relation(fields: [catalogoId], references: [id], onDelete: Cascade)
  post     Post     @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@id([catalogoId, postId])
  @@map("catalogos_posts")
}

model Curtida {
  id        Int      @id @default(autoincrement())
  usuarioId Int      @map("usuario_id")
  postId    Int      @map("post_id")
  data      DateTime @default(now())

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  post    Post    @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@unique([usuarioId, postId])
  @@map("curtidas")
}

model Comentario {
  id        Int      @id @default(autoincrement())
  usuarioId Int      @map("usuario_id")
  postId    Int      @map("post_id")
  conteudo  String   @db.Text
  data      DateTime @default(now())
  oculto    Boolean  @default(false)

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  post    Post    @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@map("comentarios")
}

enum StatusMensagem {
  nao_lido
  lido
}

model Mensagem {
  id                Int            @id @default(autoincrement())
  remetenteId       Int            @map("remetente_id")
  destinatarioId    Int            @map("destinatario_id")
  conteudo          String         @default("") @db.Text
  imagem            String?        @db.Text
  dataEnvio         DateTime       @default(now()) @map("data_envio")
  status            StatusMensagem @default(nao_lido)
  apagadaParaTodos  Boolean        @default(false) @map("apagada_para_todos")

  remetente         Usuario              @relation("Remetente", fields: [remetenteId], references: [id], onDelete: Cascade)
  destinatario      Usuario              @relation("Destinatario", fields: [destinatarioId], references: [id], onDelete: Cascade)
  deletadasPorMim   MensagemDeletada[]

  @@map("mensagens")
}

model MensagemDeletada {
  usuarioId   Int @map("usuario_id")
  mensagemId  Int @map("mensagem_id")

  usuario  Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  mensagem Mensagem @relation(fields: [mensagemId], references: [id], onDelete: Cascade)

  @@id([usuarioId, mensagemId])
  @@map("mensagens_deletadas")
}

model ConversaConfig {
  usuarioId      Int      @map("usuario_id")
  outroUsuarioId Int      @map("outro_usuario_id")
  arquivada      Boolean  @default(false)
  deletadaEm     DateTime? @map("deletada_em")
  solicitacao    String   @default("nenhuma") @map("solicitacao") // "nenhuma" | "recebida" | "enviada"

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@id([usuarioId, outroUsuarioId])
  @@map("conversa_configs")
}

model Seguidor {
  seguidorId Int      @map("seguidor_id")
  seguidoId  Int      @map("seguido_id")
  data       DateTime @default(now())

  seguidor Usuario @relation("Seguidor", fields: [seguidorId], references: [id], onDelete: Cascade)
  seguido  Usuario @relation("Seguido", fields: [seguidoId], references: [id], onDelete: Cascade)

  @@id([seguidorId, seguidoId])
  @@map("seguidores")
}

enum TipoNotificacao {
  curtida
  comentario
  seguindo
  colaboracao
  colaboracao_catalogo
  mensagem
}

model Notificacao {
  id          Int             @id @default(autoincrement())
  usuarioId   Int             @map("usuario_id")
  remetenteId Int             @map("remetente_id")
  tipo        TipoNotificacao
  postId      Int?            @map("post_id")
  catalogoId  Int?            @map("catalogo_id")
  lida        Boolean         @default(false)
  data        DateTime        @default(now())

  usuario   Usuario   @relation("NotifDestinatario", fields: [usuarioId], references: [id], onDelete: Cascade)
  remetente Usuario   @relation("NotifRemetente", fields: [remetenteId], references: [id], onDelete: Cascade)
  post      Post?     @relation(fields: [postId], references: [id], onDelete: SetNull)
  catalogo  Catalogo? @relation(fields: [catalogoId], references: [id], onDelete: SetNull)

  @@map("notificacoes")
}

model PostSalvo {
  id        Int      @id @default(autoincrement())
  usuarioId Int      @map("usuario_id")
  postId    Int      @map("post_id")
  salvadoEm DateTime @default(now()) @map("salvo_em")

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  post    Post    @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@unique([usuarioId, postId])
  @@map("posts_salvos")
}

model CatalogoSalvo {
  id         Int      @id @default(autoincrement())
  usuarioId  Int      @map("usuario_id")
  catalogoId Int      @map("catalogo_id")
  salvadoEm  DateTime @default(now()) @map("salvo_em")

  usuario  Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  catalogo Catalogo @relation(fields: [catalogoId], references: [id], onDelete: Cascade)

  @@unique([usuarioId, catalogoId])
  @@map("catalogos_salvos")
}