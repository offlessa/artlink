# Banco de dados (Supabase → Project Settings → Database → Connection string)
DATABASE_URL="postgresql://postgres:[SENHA]@[HOST]:5432/[BANCO]"

# JWT — troque por uma string longa e aleatória
JWT_SECRET="troque_por_algo_secreto_aqui"

# Cloudinary (cloudinary.com → Dashboard)
CLOUDINARY_CLOUD_NAME="seu_cloud_name"
CLOUDINARY_API_KEY="sua_api_key"
CLOUDINARY_API_SECRET="seu_api_secret"

# Email (opcional — para recuperação de senha)
RESEND_API_KEY=
EMAIL_FROM=
